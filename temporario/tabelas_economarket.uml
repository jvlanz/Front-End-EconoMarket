@startuml
entity cadastros {
	id: int
	nome: string
	rua: string
	numero: int
	cidade: string
	CEP: string
}
entity clientes {
	id: int
	fk_cadastro: int
}
entity mercados {
	id: int
	fk_cadastro: int
	validade_assinatura: date
}
cadastros-->clientes
cadastros-->mercados
entity links_mercado {
	id: int
	fk_mercado: int
	link: string
	query: string
}
mercados-->links_mercado

entity produtos {
	id: int
	descricao: string
	fk_medida: int
	valor_medida: float
	fk_categoria: int
}
entity medidas {
	id: int
	medida: string
}
entity produtos_marcas {
	id: int
	fk_produto: int
	fk_marca: int
}
entity marcas {
	id: int
	marca: string
}
entity categorias {
	id: int
	categoria: string
}
categorias-->produtos
medidas-->produtos
produtos-->produtos_marcas
marcas-->produtos_marcas

entity precos {
	id: int
	preco: float
	data: date
	fk_produtomarca: int
	fk_mercado: int
}
produtos_marcas-->precos
mercados-->precos

entity favoritos {
	id: int
	fk_produtomarca: int
	fk_cliente: int
}
clientes-->favoritos
produtos_marcas-->favoritos

entity compras {
	id: int
	data: date
	fk_listaprodutos: int
	fk_cliente: int
}
entity lista_compras {
	id: int
	fk_produtomarca: int
	fk_mercado: int
}
produtos_marcas-->lista_compras
mercados-->lista_compras
lista_compras-->compras
clientes-->compras
@enduml

