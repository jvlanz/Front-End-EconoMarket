@startuml
entity clientes {
	id: int
	nome: string
	email: string
	senha: string
	telefone: string
}
entity mercados {
	id: int
	nome: string
	link: string
}
entity produtos {
	id: int
	descricao: string
	id_categoria: int
	id_medida: int
	valor_medida: float
	figura: string
}
entity medidas {
	id: int
	medida: string
}
entity produtos_marcas {
	id: int
	id_produto: int
	id_marca: int
}
entity marcas {
	id: int
	marca: string
}
entity categorias {
	id: int
	categoria: string
}
categorias-->produtos
medidas-->produtos
produtos-->produtos_marcas
marcas-->produtos_marcas

entity precos {
	id: int
	id_produto_marca: int
	id_mercado: int
	preco: float
	data: date
}
produtos_marcas-->precos
mercados-->precos

entity favoritos {
	id: int
	id_produto_marca: int
	id_cliente: int
}
clientes-->favoritos
produtos_marcas-->favoritos

entity status {
	id: int
	status: string
}
entity compras {
	id: int
	id_lista_produtos: int
	id_cliente: int
	id_status: int
	data: date
}
entity lista_compras {
	id: int
	id_produto_marca: int
	id_mercado: int
	quantidade: float
}
status-->compras
produtos_marcas-->lista_compras
mercados-->lista_compras
lista_compras-->compras
clientes-->compras
@enduml