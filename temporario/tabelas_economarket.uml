@startuml
entity clientes {
	id: int
	nome: varchar(256)
	endereco: varchar(256)
	cidade: varchar(128)
	CEP: varchar(10)
}
entity mercados {
	id: int
	nome: varchar(256)
	rua: varchar(256)
	numero: int
	cidade: varchar(128)
	CEP: varchar(10)
	validade: date
}
entity produtos {
	id: int
	descricao: varchar(128)
	medida: varchar(16)
	fk_categoria: int
}
entity categorias {
	id: int
	categoria: varchar(128)
}
entity precos {
	id: int
	preco: float
	fk_produtos: int
	fk_mercados: int
}
produtos->precos
mercados->precos

entity favoritos {
	id: int
	fk_produtos: int
	fk_clientes: int
}
clientes->favoritos
produtos->favoritos
entity compra {
	id: int
	data: date
	fk_listaprodutos: int
	fk_clientes: int
}
entity lista_compras {
	id: int
	fk_produtos: int
	fk_mercados: int
}
produtos->lista_compras
mercados->lista_compras
@enduml